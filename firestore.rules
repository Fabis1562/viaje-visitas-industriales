rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Configuración general del viaje (itinerario, hotel, fechas, cupo)
    // - Lectura: Pública para todos los alumnos y visitantes
    // - Escritura: Restringida a administradores autenticados
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config_viaje/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Colección de interesados y registros de alumnos (DATOS PRIVADOS: nombres, teléfonos, matrículas)
    // - Crear (create): Abierto a cualquier alumno que complete el formulario
    // - Leer lista (list/get), Modificar (update) o Eliminar (delete): ESTRICTAMENTE ADMINISTRADORES AUTENTICADOS
    match /interesados_viaje/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Metadatos y contador público (almacena únicamente el número entero de registrados para el banner)
    // No contiene ningún dato personal de los alumnos
    match /metadata_viaje/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
